<Project>
  <!-- Selected with `dotnet publish -p:PublishProfile=Service`. Task 5 completes
       the trimming settings (verdict on LHM's reflection compatibility, spike S1:
       docs/superpowers/references/m4/s1-lhm.md §4/§9.2 — same 11 hardware ids,
       same 206 sensor ids, trimmed vs untrimmed on this PC; controller/PSU modules
       not verified, no such device attached). Task 13's payload script uses this
       same profile. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\Publish\</PublishDir>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Full per-call-site visibility instead of one summary warning per assembly,
         so a genuinely new trim warning is never hidden behind an already-accepted
         one from the same library. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- TreatWarningsAsErrors stays on globally (Directory.Build.props) — trim
         warnings are plain MSBuild warnings during publish, so without this they
         would already fail the build today. The 5 IL codes below are the exact
         set accepted in docs/superpowers/references/m4/trim-warnings.md (10 call
         sites across LibreHardwareMonitorLib/HidSharp, all on Unix-only, MTA-only
         or disabled-module code paths, confirmed identical trimmed vs untrimmed
         sensor set). Demoting them back to warnings is coarser than the
         accepted list (per code, not per exact origin), so a brand-new warning
         that happens to reuse one of these 5 codes at a different call site would
         not fail the build automatically — the spike's diff method (identical
         hardware/sensor ids trimmed vs untrimmed) is what actually re-validates
         the list on a dependency bump, and any new code outside this set still
         fails the build as an error. See trim-warnings.md for the per-origin
         reasoning that justifies each code here. -->
    <WarningsNotAsErrors>IL2026;IL2075;IL2067;IL2077;IL2091</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
