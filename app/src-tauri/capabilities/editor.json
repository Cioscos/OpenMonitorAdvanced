{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Overlay editor window: event subscriptions, closing itself after a save or discard, the sensor reads and settings it shows, the overlay status, the editor's profile commands and font list, the preview, «Use now», the unsaved-changes flag and confirming a quit.",
  "windows": ["overlay-editor"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "allow-get-schema",
    "allow-get-history",
    "allow-get-disk-states",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-overlay-status",
    "allow-overlay-load-profile",
    "allow-overlay-save-profile",
    "allow-overlay-delete-profile",
    "allow-overlay-duplicate-profile",
    "allow-overlay-import-profile",
    "allow-overlay-export-profile",
    "allow-overlay-font-families",
    "allow-overlay-preview",
    "allow-overlay-use-now",
    "allow-overlay-editor-dirty",
    "allow-overlay-editor-profile",
    "allow-app-quit-confirmed"
  ]
}
