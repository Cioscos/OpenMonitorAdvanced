<Project>
  <!-- Selected with `dotnet publish -p:PublishProfile=Service`. Task 5 completes
       the trimming settings (verdict on LHM's reflection compatibility, spike S1:
       docs/superpowers/references/m4/s1-lhm.md §4/§9.2 — same 11 hardware ids,
       same 206 sensor ids, trimmed vs untrimmed on this PC; controller/PSU modules
       not verified, no such device attached). Task 13's payload script uses this
       same profile. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- false: a LocalSystem process must never extract native DLLs to a temp folder at run time.
         The bundle has none today; should a package bring one, it lands next to the exe instead,
         and scripts/build-installer-payload.ps1 fails, because the installer copies only the exe. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\Publish\</PublishDir>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Full per-call-site visibility instead of one summary warning per assembly,
         so a genuinely new trim warning is never hidden behind an already-accepted
         one from the same library. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- TreatWarningsAsErrors stays on globally (Directory.Build.props) — trim
         warnings are plain MSBuild warnings during publish, so without this they
         would already fail the build today. The 5 IL codes below are only the
         coarse, code-level half of the gate: they let MSBuild itself get past a
         publish that reproduces the exact warnings in
         docs/superpowers/references/m4/trim-warnings.md (10 call sites across
         LibreHardwareMonitorLib/HidSharp, all on Unix-only, MTA-only or
         disabled-module code paths, confirmed identical trimmed vs untrimmed
         sensor set), instead of MSBuild aborting before the real check ever
         runs. Demoting a whole code is NOT the enforcement of the accepted
         list — a new warning that reuses one of these 5 codes at a different,
         unreviewed call site would otherwise pass silently. The actual
         per-origin gate is scripts/check-trim-warnings.ps1, run after this
         publish: it parses every ILxxxx warning's exact (code, origin) pair out
         of the publish log and fails on anything not listed in
         service/trim-allowlist.txt (see that file's header), regardless of
         whether the code alone is demoted here. Only the 5 codes actually
         present in trim-allowlist.txt belong in this property. -->
    <WarningsNotAsErrors>IL2026;IL2075;IL2067;IL2077;IL2091</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
