<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <AssemblyName>oma-service</AssemblyName>
    <RootNamespace>OpenMonitorAdvanced.Service</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- SelfContained, PublishSingleFile and trimming are set only in
         Properties/PublishProfiles/Service.pubxml (published with
         -p:PublishProfile=Service), never here: a plain `dotnet build`/
         `dotnet test` — including the Tests project's ProjectReference to
         this project — must not attempt a self-contained/single-file build. -->
    <!-- Memory budget (< 80 MB private; spike S1 measured 63–84 MB, s1-lhm.md §9.6):
         workstation, non-concurrent GC (no background GC thread and its extra
         heap growth), plus ConserveMemory below. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0–9: how hard the GC compacts to keep the heap small instead of growing it. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- LHM tree -> wire schema mapping (Task 5); Sensors/HardwareNode.cs is a
         read-only view so the mapping is testable without LHM or admin rights. -->
    <PackageReference Include="LibreHardwareMonitorLib" />
    <!-- LHM's Unix helper: its native MonoPosixHelper.dll/libMonoPosixHelper.dll are only loaded on
         Linux/macOS code paths. Without them the publish output is oma-service.exe alone, which is
         all the installer copies (scripts/build-installer-payload.ps1 enforces it), and nothing
         native is bundled for a LocalSystem process to extract at run time. -->
    <PackageReference Include="Mono.Posix.NETStandard" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets OpenMonitorAdvanced.Service.Tests exercise MessageStructureValidator
         (internal) directly, for boundary assertions ("exactly at the limit is
         accepted") that would otherwise be indistinguishable from an unrelated
         envelope-shape decode error if only MessageCodec's public API were used. -->
    <InternalsVisibleTo Include="OpenMonitorAdvanced.Service.Tests" />
  </ItemGroup>

</Project>
