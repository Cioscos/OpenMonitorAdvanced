{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: sensor reads, statistics and session, event subscriptions, leaving GPU safe mode and the settings.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-schema",
    "allow-get-history",
    "allow-get-stats",
    "allow-reset-stats",
    "allow-get-session",
    "allow-get-gpu-processes",
    "allow-get-startup-status",
    "allow-enable-vendor-libraries",
    "allow-get-service-status",
    "allow-set-anti-cheat",
    "allow-start-service",
    "allow-get-settings",
    "allow-update-settings"
  ]
}
