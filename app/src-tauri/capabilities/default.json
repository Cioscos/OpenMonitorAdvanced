{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: sensor reads, statistics and session, reading the disk power states, the health report, rule status and built-in rules, event subscriptions, leaving GPU safe mode, the settings, the About page and opening its fixed folders, the CSV log commands, opening and choosing the log folder, suspending the log hotkeys while one is captured, checking for updates and opening the page of the available release, and exporting the anonymous sensor report and opening the folder of the last one; the overlay editor's profile commands and font list.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-schema",
    "allow-get-history",
    "allow-get-stats",
    "allow-reset-stats",
    "allow-get-session",
    "allow-get-disk-states",
    "allow-get-gpu-processes",
    "allow-get-startup-status",
    "allow-enable-vendor-libraries",
    "allow-get-service-status",
    "allow-set-anti-cheat",
    "allow-start-service",
    "allow-get-settings",
    "allow-update-settings",
    "allow-reset-rule-override",
    "allow-import-webview-state",
    "allow-take-pending-view",
    "allow-refresh-autostart",
    "allow-get-app-info",
    "allow-open-known-path",
    "allow-get-health",
    "allow-get-rule-status",
    "allow-get-default-rules",
    "allow-get-health-clock",
    "allow-log-start",
    "allow-log-pause",
    "allow-log-resume",
    "allow-log-stop",
    "allow-get-log-status",
    "allow-open-log-folder",
    "allow-pick-log-folder",
    "allow-set-log-hotkeys-suspended",
    "allow-check-updates",
    "allow-get-update-status",
    "allow-open-release-page",
    "allow-export-sensor-report",
    "allow-reveal-sensor-report",
    "allow-get-overlay-status",
    "allow-overlay-retry",
    "allow-overlay-reload-profiles",
    "allow-set-overlay-hidden",
    "allow-overlay-load-profile",
    "allow-overlay-save-profile",
    "allow-overlay-delete-profile",
    "allow-overlay-duplicate-profile",
    "allow-overlay-import-profile",
    "allow-overlay-export-profile",
    "allow-overlay-font-families"
  ]
}
