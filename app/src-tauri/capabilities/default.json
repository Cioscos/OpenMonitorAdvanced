{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: sensor reads, statistics and session, the health report, rule status and built-in rules, event subscriptions, leaving GPU safe mode, the settings, the About page and opening its fixed folders.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-schema",
    "allow-get-history",
    "allow-get-stats",
    "allow-reset-stats",
    "allow-get-session",
    "allow-get-gpu-processes",
    "allow-get-startup-status",
    "allow-enable-vendor-libraries",
    "allow-get-service-status",
    "allow-set-anti-cheat",
    "allow-start-service",
    "allow-get-settings",
    "allow-update-settings",
    "allow-reset-rule-override",
    "allow-import-webview-state",
    "allow-take-pending-view",
    "allow-refresh-autostart",
    "allow-get-app-info",
    "allow-open-known-path",
    "allow-get-health",
    "allow-get-rule-status",
    "allow-get-default-rules",
    "allow-get-health-clock"
  ]
}
